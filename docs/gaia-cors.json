{
  "CORSRules": [
    {
      "ID": "public-read-any-origin",
      "AllowedOrigins": ["*"],
      "AllowedMethods": ["GET", "HEAD"],
      "AllowedHeaders": ["*"],
      "ExposeHeaders": ["ETag", "Content-Length", "Content-Range", "Content-Type", "Accept-Ranges", "Last-Modified"],
      "MaxAgeSeconds": 3600
    }
  ]
}
