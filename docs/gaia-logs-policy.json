{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLoggingFromGaia",
      "Effect": "Allow",
      "Principal": {"Service": "logging.s3.amazonaws.com"},
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::gaia-logs/gaia/*",
      "Condition": {
        "ArnLike": {"aws:SourceArn": "arn:aws:s3:::gaia"}
      }
    }
  ]
}
